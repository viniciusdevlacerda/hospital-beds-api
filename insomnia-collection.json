      "settingSendCookies": true,
      "settingDisableRenderRequestBody": false,
      "settingEncodeUrl": true,
      "settingRebuildPath": true,
      "settingFollowRedirects": "global"
    },
    {
      "_id": "req_transfer",
      "_type": "request",
      "parentId": "wrk_hospital_beds",
      "name": "Transferir paciente para outro leito",
      "description": "201 Created.\n\nEncerra a ocupação atual com motivo `transfer` e abre a nova na mesma transação: o paciente nunca fica sem leito num estado intermediário.\n\n409 se o destino estiver ocupado; 422 TRANSFER_TO_SAME_BED se for o leito atual.",
      "method": "POST",
      "url": "{{ _.base_url }}/transfers",
      "headers": [
        {
          "id": "pair_req_transfer_accept",
          "name": "Accept",
          "value": "application/json"
        },
        {
          "id": "pair_req_transfer_ct",
          "name": "Content-Type",
          "value": "application/json"
        }
      ],
      "parameters": [],
      "authentication": {},
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"cpf\": \"{{ _.cpf }}\",\n  \"to_bed\": \"{{ _.bed_code_target }}\"\n}"
      },
      "preRequestScript": "",
      "afterResponseScript": "",
      "metaSortKey": -300,
      "isPrivate": false,
      "pathParameters": [],
      "settingStoreCookies": true,
      "settingSendCookies": true,
      "settingDisableRenderRequestBody": false,
      "settingEncodeUrl": true,
      "settingRebuildPath": true,
      "settingFollowRedirects": "global"
    },
