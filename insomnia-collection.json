    {
      "_id": "wrk_hospital_beds",
      "_type": "workspace",
      "parentId": null,
      "name": "Hospital Beds API",
      "description": "Uma requisição por rota da API, na ordem em que o desafio lista os casos de uso.\n\nSuba a stack com `docker compose up -d --build`. Os leitos vêm dos seeders (UTI-01..UTI-06, ENF-01..ENF-12, APT-01..APT-04) e sete nascem ocupados por sorteio — rode a listagem primeiro e ajuste `bed_code` no Base Environment para um leito livre.",
      "scope": "collection"
    },
    {
      "_id": "env_hospital_base",
      "_type": "environment",
      "parentId": "wrk_hospital_beds",
      "name": "Base Environment",
      "data": {
        "host": "http://localhost:8080",
        "base_url": "http://localhost:8080/api",
        "bed_code": "UTI-01",
        "bed_code_target": "ENF-07",
        "cpf": "529.982.247-25",
        "patient_name": "Maria Andrade"
      },
      "dataPropertyOrder": {
        "&": [
          "host",
          "base_url",
          "bed_code",
          "bed_code_target",
          "cpf",
          "patient_name"
        ]
      },
      "color": null,
      "isPrivate": false,
      "metaSortKey": 1
    },
    {
      "_id": "jar_hospital",
      "_type": "cookie_jar",
      "parentId": "wrk_hospital_beds",
      "name": "Default Jar",
      "cookies": []
    },
    {
      "_id": "req_occupy",
      "_type": "request",
      "parentId": "wrk_hospital_beds",
      "name": "Incluir paciente em um leito",
      "description": "201 Created.\n\nO paciente é criado na primeira internação e reaproveitado pelo CPF nas seguintes — o desafio dispensa CRUD de pacientes.\n\n409 BED_ALREADY_OCCUPIED se o leito estiver ocupado; 409 PATIENT_ALREADY_ADMITTED se o paciente já estiver em outro leito.",
      "method": "POST",
      "url": "{{ _.base_url }}/beds/{{ _.bed_code }}/occupation",
      "headers": [
        {
          "id": "pair_req_occupy_accept",
          "name": "Accept",
          "value": "application/json"
        },
        {
          "id": "pair_req_occupy_ct",
          "name": "Content-Type",
          "value": "application/json"
        }
      ],
      "parameters": [],
      "authentication": {},
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"cpf\": \"{{ _.cpf }}\",\n  \"name\": \"{{ _.patient_name }}\"\n}"
      },
      "preRequestScript": "",
      "afterResponseScript": "",
      "metaSortKey": -100,
      "isPrivate": false,
      "pathParameters": [],
      "settingStoreCookies": true,
      "settingSendCookies": true,
      "settingDisableRenderRequestBody": false,
      "settingEncodeUrl": true,
      "settingRebuildPath": true,
      "settingFollowRedirects": "global"
    },
    {
      "_id": "req_release",
      "_type": "request",
      "parentId": "wrk_hospital_beds",
      "name": "Desocupar um leito",
      "description": "200 OK. Encerra a ocupação com motivo `discharge`.\n\n409 BED_NOT_OCCUPIED se o leito já estiver livre.",
      "method": "DELETE",
      "url": "{{ _.base_url }}/beds/{{ _.bed_code }}/occupation",
      "headers": [
        {
          "id": "pair_req_release_accept",
          "name": "Accept",
          "value": "application/json"
        }
      ],
      "parameters": [],
      "authentication": {},
      "body": {},
      "preRequestScript": "",
      "afterResponseScript": "",
      "metaSortKey": -200,
      "isPrivate": false,
